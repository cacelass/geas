# geas.yml — Configuración de la instancia (generada por Copier)
# Spec §37: cada empresa tiene su propia instancia con su configuración.

organization: "{{ organization }}"
git_provider: "{{ git_provider }}"
deployment_profile: "{{ deployment_profile }}"
database: "{{ database }}"

web_ui: {{ web_ui|lower }}
mcp_enabled: {{ mcp_enabled|lower }}
ai_agents: {{ ai_agents|lower }}
departments: {{ departments|lower }}
authentication: "{{ authentication }}"
harness: "{{ harness }}"